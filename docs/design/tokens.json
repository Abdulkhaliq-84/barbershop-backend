{
  "$description": "Barbershop app design tokens (W3C design-tokens style). Source of truth for Figma variables and the Flutter theme. Human guide: docs/design/design-system.md",
  "color": {
    "green": {
      "50":  { "$type": "color", "$value": "#E8F5EF" },
      "100": { "$type": "color", "$value": "#C6E7D7" },
      "200": { "$type": "color", "$value": "#9FD6BC" },
      "300": { "$type": "color", "$value": "#6FC19C" },
      "400": { "$type": "color", "$value": "#3FA97B" },
      "500": { "$type": "color", "$value": "#1C9063" },
      "600": { "$type": "color", "$value": "#127A56", "$description": "Brand green" },
      "700": { "$type": "color", "$value": "#0E6246" },
      "800": { "$type": "color", "$value": "#0A4A35" },
      "900": { "$type": "color", "$value": "#063324" }
    },
    "navy": {
      "50":  { "$type": "color", "$value": "#EEF1F8" },
      "100": { "$type": "color", "$value": "#D5DCEC" },
      "200": { "$type": "color", "$value": "#AEBAD8" },
      "300": { "$type": "color", "$value": "#8093BF" },
      "400": { "$type": "color", "$value": "#56699F" },
      "500": { "$type": "color", "$value": "#394D82" },
      "600": { "$type": "color", "$value": "#28396A" },
      "700": { "$type": "color", "$value": "#1C2A52" },
      "800": { "$type": "color", "$value": "#13203F", "$description": "Brand navy (ink)" },
      "900": { "$type": "color", "$value": "#0B1530" },
      "950": { "$type": "color", "$value": "#070E22" }
    },
    "neutral": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "25":  { "$type": "color", "$value": "#FAFBFC" },
      "50":  { "$type": "color", "$value": "#F4F6F8" },
      "100": { "$type": "color", "$value": "#E9EDF1" },
      "200": { "$type": "color", "$value": "#D7DDE3" },
      "300": { "$type": "color", "$value": "#B9C2CC" },
      "400": { "$type": "color", "$value": "#8E99A6", "$description": "Disabled only — fails contrast for text" },
      "500": { "$type": "color", "$value": "#6B7684" },
      "600": { "$type": "color", "$value": "#525C69" },
      "700": { "$type": "color", "$value": "#3C4550" },
      "800": { "$type": "color", "$value": "#262D35" },
      "900": { "$type": "color", "$value": "#151A20" }
    },
    "feedback": {
      "success":   { "$type": "color", "$value": "{color.green.600}" },
      "successBg": { "$type": "color", "$value": "{color.green.50}" },
      "warning":   { "$type": "color", "$value": "#A15F00" },
      "warningBg": { "$type": "color", "$value": "#FFF4E0" },
      "error":     { "$type": "color", "$value": "#C62F2F" },
      "errorBg":   { "$type": "color", "$value": "#FDECEC" },
      "info":      { "$type": "color", "$value": "{color.navy.500}" },
      "infoBg":    { "$type": "color", "$value": "{color.navy.50}" }
    }
  },
  "theme": {
    "light-a": {
      "$description": "Default: green · navy · white",
      "primary":              { "$type": "color", "$value": "{color.green.600}" },
      "onPrimary":            { "$type": "color", "$value": "{color.neutral.0}" },
      "primaryContainer":     { "$type": "color", "$value": "{color.green.50}" },
      "onPrimaryContainer":   { "$type": "color", "$value": "{color.green.800}" },
      "secondary":            { "$type": "color", "$value": "{color.navy.800}" },
      "onSecondary":          { "$type": "color", "$value": "{color.neutral.0}" },
      "secondaryContainer":   { "$type": "color", "$value": "{color.navy.50}" },
      "hero":                 { "$type": "color", "$value": "{color.navy.900}" },
      "heroAccent":           { "$type": "color", "$value": "{color.green.300}" },
      "heroMuted":            { "$type": "color", "$value": "{color.navy.200}" },
      "background":           { "$type": "color", "$value": "{color.neutral.25}" },
      "surface":              { "$type": "color", "$value": "{color.neutral.0}" },
      "surfaceContainer":     { "$type": "color", "$value": "{color.neutral.50}" },
      "outline":              { "$type": "color", "$value": "{color.neutral.200}" },
      "outlineStrong":        { "$type": "color", "$value": "{color.neutral.300}" },
      "textPrimary":          { "$type": "color", "$value": "{color.navy.800}" },
      "textSecondary":        { "$type": "color", "$value": "{color.neutral.600}" },
      "textPlaceholder":      { "$type": "color", "$value": "{color.neutral.500}" },
      "textDisabled":         { "$type": "color", "$value": "{color.neutral.400}" }
    },
    "light-b": {
      "$description": "Alternative: green · white",
      "primary":              { "$type": "color", "$value": "{color.green.600}" },
      "onPrimary":            { "$type": "color", "$value": "{color.neutral.0}" },
      "primaryContainer":     { "$type": "color", "$value": "{color.green.50}" },
      "onPrimaryContainer":   { "$type": "color", "$value": "{color.green.800}" },
      "secondary":            { "$type": "color", "$value": "{color.green.800}" },
      "onSecondary":          { "$type": "color", "$value": "{color.neutral.0}" },
      "hero":                 { "$type": "color", "$value": "{color.green.700}" },
      "heroAccent":           { "$type": "color", "$value": "{color.green.100}" },
      "heroMuted":            { "$type": "color", "$value": "{color.green.100}" },
      "background":           { "$type": "color", "$value": "{color.neutral.25}" },
      "surface":              { "$type": "color", "$value": "{color.neutral.0}" },
      "textPrimary":          { "$type": "color", "$value": "{color.neutral.900}" },
      "textSecondary":        { "$type": "color", "$value": "{color.neutral.600}" }
    },
    "dark": {
      "$description": "Tokens ready; ships after light",
      "primary":              { "$type": "color", "$value": "{color.green.400}" },
      "onPrimary":            { "$type": "color", "$value": "{color.navy.950}" },
      "background":           { "$type": "color", "$value": "{color.navy.950}" },
      "surface":              { "$type": "color", "$value": "{color.navy.900}" },
      "surfaceContainer":     { "$type": "color", "$value": "{color.navy.800}" },
      "outline":              { "$type": "color", "$value": "{color.navy.700}" },
      "textPrimary":          { "$type": "color", "$value": "{color.navy.50}" },
      "textSecondary":        { "$type": "color", "$value": "{color.navy.200}" }
    }
  },
  "font": {
    "family": {
      "arabic": { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "IBM Plex Sans", "sans-serif"] },
      "latin":  { "$type": "fontFamily", "$value": ["IBM Plex Sans", "IBM Plex Sans Arabic", "sans-serif"] },
      "mono":   { "$type": "fontFamily", "$value": ["IBM Plex Mono", "monospace"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "displaySmall":  { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "44px", "fontWeight": 700 } },
    "headlineSmall": { "$type": "typography", "$value": { "fontSize": "24px", "lineHeight": "34px", "fontWeight": 700 } },
    "titleLarge":    { "$type": "typography", "$value": { "fontSize": "20px", "lineHeight": "30px", "fontWeight": 600 } },
    "titleMedium":   { "$type": "typography", "$value": { "fontSize": "17px", "lineHeight": "26px", "fontWeight": 600 } },
    "bodyLarge":     { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "26px", "fontWeight": 400 } },
    "bodyMedium":    { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": "22px", "fontWeight": 400 } },
    "labelLarge":    { "$type": "typography", "$value": { "fontSize": "15px", "lineHeight": "22px", "fontWeight": 600 } },
    "labelMedium":   { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": 500 } },
    "bodySmall":     { "$type": "typography", "$value": { "fontSize": "12px", "lineHeight": "18px", "fontWeight": 400 } }
  },
  "spacing": {
    "0.5": { "$type": "dimension", "$value": "2px" },
    "1":   { "$type": "dimension", "$value": "4px" },
    "2":   { "$type": "dimension", "$value": "8px" },
    "3":   { "$type": "dimension", "$value": "12px" },
    "4":   { "$type": "dimension", "$value": "16px" },
    "5":   { "$type": "dimension", "$value": "20px", "$description": "Screen side padding" },
    "6":   { "$type": "dimension", "$value": "24px" },
    "8":   { "$type": "dimension", "$value": "32px" },
    "10":  { "$type": "dimension", "$value": "40px" },
    "14":  { "$type": "dimension", "$value": "56px" }
  },
  "radius": {
    "xs":   { "$type": "dimension", "$value": "8px",   "$description": "Badges, small chips" },
    "sm":   { "$type": "dimension", "$value": "12px",  "$description": "Inputs, OTP boxes" },
    "md":   { "$type": "dimension", "$value": "16px",  "$description": "Cards" },
    "lg":   { "$type": "dimension", "$value": "24px",  "$description": "Sheets, large cards" },
    "xl":   { "$type": "dimension", "$value": "32px",  "$description": "Hero, bento tiles" },
    "full": { "$type": "dimension", "$value": "999px", "$description": "Buttons, slots, search, nav, avatars" }
  },
  "size": {
    "touchTarget":   { "$type": "dimension", "$value": "48px" },
    "buttonPrimary": { "$type": "dimension", "$value": "56px" },
    "slotChip":      { "$type": "dimension", "$value": "44px" },
    "bottomNav":     { "$type": "dimension", "$value": "64px" }
  },
  "shadow": {
    "e1": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px",  "blur": "2px",  "spread": "0px", "color": "rgba(19,32,63,0.06)" } },
    "e2": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px",  "blur": "24px", "spread": "0px", "color": "rgba(19,32,63,0.08)" } },
    "e3": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "16px", "blur": "40px", "spread": "0px", "color": "rgba(19,32,63,0.16)" } }
  },
  "glass": {
    "fill": { "$type": "color", "$value": "rgba(255,255,255,0.72)" },
    "blur": { "$type": "dimension", "$value": "20px" }
  },
  "motion": {
    "micro":    { "$type": "duration", "$value": "150ms" },
    "standard": { "$type": "duration", "$value": "250ms" },
    "sheet":    { "$type": "duration", "$value": "400ms" },
    "easing":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "motif": {
    "barberPoleStripe": {
      "$type": "gradient",
      "$description": "45° repeating stripe: green 8px, white 6px, navy 8px, white 6px. Use on ≤ 5% of a screen.",
      "$value": "repeating-linear-gradient(-45deg, #127A56 0 8px, #FFFFFF 8px 14px, #13203F 14px 22px, #FFFFFF 22px 28px)"
    }
  }
}
