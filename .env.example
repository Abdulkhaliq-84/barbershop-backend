# Configuration reference. The app reads real environment variables only
# (12-factor) — it never loads this file. `make` targets already set
# DATABASE_URL for local development; export others in your shell as needed.

APP_ENV=development                  # development | test | staging | production
DATABASE_URL=postgres://barbershop:barbershop@localhost:5432/barbershop?sslmode=disable
DATABASE_MAX_CONNS=10

HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s

LOG_LEVEL=info                       # debug | info | warn | error
LOG_FORMAT=json                      # json | text

# Login (phone OTP). OTP_SECRET keys the HMAC of stored codes: at least 32
# bytes, different per environment, kept in a secret store — never committed.
# Generate one with: openssl rand -base64 48
OTP_SECRET=local-development-otp-secret-not-for-real-use
SMS_PROVIDER=console                 # console (prints codes to the log; refused in production)

# Access tokens are signed with an Ed25519 key derived from this secret: at
# least 32 bytes, per environment, never committed. Anyone who knows it can
# sign in as any user. Generate one with: openssl rand -base64 48
# The development values of OTP_SECRET and TOKEN_SIGNING_SECRET are refused
# when APP_ENV is staging or production.
TOKEN_SIGNING_SECRET=local-development-token-signing-secret-not-for-real-use
